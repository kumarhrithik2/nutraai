# Copy this file to `.env` (git-ignored) and adjust the values for your machine.

# Base path every API call uses (see src/services/apiBackend/core.js).
# Keep it RELATIVE in development: the Vite dev server proxies /api to Django
# (see vite.config.js), so the HTTP-only refresh cookie stays first-party and the
# browser never has to make a cross-site cookie request.
VITE_API_BASE_URL=/api/v1

# Origin the Vite dev-server proxy forwards /api requests to.
# Backend origin only - no /api/v1 suffix, it is already part of the request path.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Development-only: open the dashboard with sample data without signing in.
# Ignored by production builds (AuthContext checks import.meta.env.DEV).
VITE_ENABLE_PREVIEW_MODE=false
